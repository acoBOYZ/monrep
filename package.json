{
  "name": "monrep-mono",
  "version": "0.6.0",
  "type": "module",
  "author": "Ahmet Cevdet ÖZTÜRK",
  "description": "A monorepo template built with Bun, Hono, Vite, and React",
  "homepage": "https://github.com/monrep",
  "keywords": [
    "bun",
    "hono",
    "react",
    "vite",
    "tanstack",
    "electricsql",
    "monorepo",
    "turbo"
  ],
  "intent": {
    "skills": [
      "workspace:@monrep/agent-skills"
    ]
  },
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "create:app": "bun scripts/pkg/create-app.ts",
    "codegen": "bun run --cwd packages/codegen codegen",
    "up": "bun scripts/stack/up-dev.ts",
    "setup:dev": "bun scripts/stack/setup-dev.ts",
    "dev": "NODE_ENV=development turbo run dev --concurrency=20",
    "build": "turbo run build --ui tui",
    "addto": "bun scripts/pkg/add.ts",
    "removeto": "bun scripts/pkg/remove.ts",
    "git:prune-branches:list": "bun scripts/git/prune-merged-branches.ts",
    "git:prune-branches": "bun scripts/git/prune-merged-branches.ts -- --yes",
    "devtools": "turbo devtools --no-open",
    "clean": "bunx turbo run clean --concurrency=50%",
    "nuke": "bun run --bun clean && bunx rimraf .turbo node_modules bun.lock",
    "ok": "bun typecheck && bun fmtcheck && bun lint && bun doctor -y",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "fmt": "turbo fmt",
    "fmtcheck": "turbo fmtcheck",
    "test": "turbo run test",
    "doctor": "env -u CODEX_CI bunx react-doctor --verbose",
    "release:bumped-version": "bun scripts/release/bumped-version.ts",
    "release:set-version": "bun scripts/release/set-version.ts",
    "release:changelog": "bun scripts/release/generate-changelog.ts",
    "release:notes": "bun scripts/release/release-notes.ts",
    "release:tag": "bun scripts/release/tag.ts",
    "ci:install": "bun install --frozen-lockfile",
    "ci:assert-clean": "git diff --exit-code",
    "docker:gc": "docker builder prune -f",
    "build:main": "NODE_ENV=production REACT_COMPILER=true TURBO_TELEMETRY_DISABLED=1 turbo run build --filter=@monrep/main --only --ui stream",
    "deploy:main": "bun run --cwd packages/main deploy",
    "cf-typegen:main": "bun run --cwd packages/main cf-typegen",
    "skills:sync-versions": "bun scripts/skills/sync-versions.ts",
    "skills:validate": "intent validate packages/agent-skills/skills",
    "skills:stale": "intent stale packages/agent-skills",
    "skills:list": "intent list",
    "skills:load": "intent load",
    "skills:install": "intent install --map",
    "skills:cf-up": "bun scripts/skills/upgrade-cf.ts",
    "skills:check": "bun run skills:sync-versions && bun run skills:validate && bun run skills:stale",
    "knip": "knip --production"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.46.0",
    "@monrep/agent-skills": "workspace:*",
    "@shadcn/lint": "^0.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/intent": "^0.4.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "bun-scan": "^1.1.2",
    "git-cliff": "^2.14.2",
    "knip": "^6.38.0",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "react-doctor": "^0.9.14",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.4",
    "typescript": "^7.0.2"
  },
  "overrides": {},
  "patchedDependencies": {
    "@durable-streams/server-cloudflare@0.1.1": "patches/@durable-streams%2Fserver-cloudflare@0.1.1.patch"
  }
}
