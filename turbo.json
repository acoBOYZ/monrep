{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "cacheMaxAge": "14d",
  "tasks": {
    "build:types": {
      "inputs": [
        "src/**/*.{ts,tsx,d.ts}",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json"
      ],
      "outputs": [
        "dist/**/*.d.ts",
        "lib/**/*.d.ts"
      ],
      "env": [
        "NODE_ENV"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.{ts,tsx,js,jsx,json}",
        "src/**/*.{css,scss,sass,pcss}",
        "src/styles/**/*",
        "tsconfig.json",
        "tsconfig.*.json",
        "vite.config.ts",
        "package.json",
        "bun.lock",
        "index.html"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".bundle/**",
        "meta.md"
      ],
      "env": [
        "NODE_ENV",
        "VITE_*",
        "REACT_COMPILER",
        "REACT_RELEASE"
      ]
    },
    "dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true,
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx,json}",
        "src/**/*.{css,scss,sass,pcss}",
        "tsconfig.json",
        "tsconfig.*.json",
        "vite.config.ts",
        "package.json",
        "src/**/*.rs",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml"
      ],
      "env": [
        "NODE_ENV",
        "PORT",
        "VITE_*"
      ]
    },
    "typecheck": {
      "dependsOn": [],
      "inputs": [
        "src/**/*.{ts,tsx,d.ts}",
        "tsconfig.json",
        "tsconfig.*.json",
        "package.json",
        "src/**/*.rs",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "miri/**",
        "scripts/rust-miri.ts"
      ],
      "env": [
        "NODE_ENV"
      ]
    },
    "lint": {
      "dependsOn": [],
      "cache": true,
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        ".oxlintrc.json",
        "package.json",
        "tsconfig.json",
        "tsconfig.*.json",
        "src/**/*.rs",
        "Cargo.toml",
        "Cargo.lock",
        "rust-toolchain.toml",
        "scripts/**"
      ],
      "env": [
        "NODE_ENV"
      ]
    },
    "test": {
      "dependsOn": [],
      "inputs": [
        "src/**/*.{ts,tsx,js,jsx}",
        "test/**/*.{ts,tsx,js,jsx}",
        "__tests__/**/*.{ts,tsx}",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "jest.config.*",
        "vitest.config.*",
        "package.json",
        "tsconfig.json",
        "tsconfig.*.json",
        "**/*.go",
        "go.mod",
        "go.sum",
        "benchmark/**"
      ],
      "outputs": [
        "coverage/**",
        ".nyc_output/**",
        "test-results/**"
      ],
      "env": [
        "NODE_ENV",
        "CI"
      ]
    },
    "clean": {
      "dependsOn": [],
      "cache": false,
      "persistent": false
    },
    "fmt": {
      "cache": true,
      "inputs": [
        "src/**/*.{ts,tsx,css,scss,md}",
        ".oxfmtrc.jsonc",
        ".oxlintrc.json",
        "package.json",
        "src/**/*.rs",
        "miri/**/*.rs",
        "Cargo.toml",
        "rust-toolchain.toml",
        "scripts/**"
      ]
    },
    "fmtcheck": {
      "cache": true,
      "inputs": [
        "src/**/*.{ts,tsx,css,scss,md}",
        ".oxfmtrc.jsonc",
        ".oxlintrc.json",
        "package.json",
        "src/**/*.rs",
        "miri/**/*.rs",
        "Cargo.toml",
        "rust-toolchain.toml",
        "scripts/**"
      ]
    }
  },
  "globalDependencies": [
    "**/.env",
    "**/.env.*",
    "**/.env.local",
    "**/.env.*.local",
    ".gitignore",
    "turbo.json",
    "package.json",
    "bun.lock",
    "tsconfig.json",
    "doctor.config.ts",
    ".oxlintrc.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "TURBO_REMOTE_ONLY"
  ]
}