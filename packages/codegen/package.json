{
  "name": "@monrep/codegen",
  "version": "1.0.0",
  "private": true,
  "author": "ACO .",
  "type": "module",
  "exports": {
    "./config": "./src/config.ts"
  },
  "scripts": {
    "codegen": "bun src/cli.ts start",
    "watch": "bun --no-orphans src/cli.ts watch",
    "dev": "bun --no-orphans src/cli.ts watch",
    "typecheck": "tsc --noEmit --singleThreaded",
    "lint": "oxlint --threads=1 src .",
    "clean": "rimraf dist node_modules bun.lock .turbo",
    "fmt": "oxfmt src",
    "fmtcheck": "oxfmt --check src"
  },
  "dependencies": {
    "@monrep/utils": "workspace:^",
    "@tanstack/pacer": "0.22.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
