{
  "name": "@monrep/agent-skills",
  "version": "0.5.2",
  "private": true,
  "description": "Workspace-only Agent Skills for the monrep monorepo. React standards, quality gates, and conventions consumed via TanStack Intent (not published to npm)",
  "type": "module",
  "author": "Ahmet Cevdet ÖZTÜRK",
  "license": "MIT",
  "homepage": "https://github.com/monrepco/monrep-mono",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monrepco/monrep-mono.git",
    "directory": "packages/agent-skills"
  },
  "keywords": [
    "agent-skills",
    "cursor",
    "claude",
    "react",
