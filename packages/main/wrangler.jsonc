{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "monrep",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-04",
  "main": "./src/server/worker.ts",
  
  "durable_objects": {
    "bindings": [
      {
        "name": "STREAMS",
        "class_name": "StreamObject"
      },
      {
        "name": "AGENT_SESSIONS",
        "class_name": "AgentSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StreamObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AgentSession"]
    }
  ],
  "previews": {
    "cache": {
      "enabled": true
    }
  },
  "dev": {
    "inspector_port": 9329,
    "local_protocol": "https"
  }
}
