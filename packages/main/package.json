{
  "name": "@monrep/main",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite dev --port 5274",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit --singleThreaded",
    "lint": "oxlint --threads=1 src .",
    "fmt": "oxfmt src",
    "fmtcheck": "oxfmt --check src",
    "clean": "rimraf dist .tanstack node_modules bun.lock .turbo .wrangler",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@durable-streams/client": "^0.2.7",
    "@durable-streams/server-cloudflare": "^0.1.1",
    "@durable-streams/state": "^0.3.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@monrep/db": "workspace:^",
    "@monrep/ui": "workspace:^",
    "@monrep/utils": "workspace:^",
    "@tanstack/react-db": "^0.4.1",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "@tanstack/react-store": "^0.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@monrep/codegen": "workspace:^",
    "@cloudflare/vite-plugin": "^1.60.1",
    "@rolldown/plugin-babel": "^0.2.4",
