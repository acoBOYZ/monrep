{
  "name": "@monrep/main",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "REACT_COMPILER=true vite dev --port 5274",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit --singleThreaded",
    "lint": "oxlint --threads=1 src .",
    "fmt": "oxfmt src",
    "fmtcheck": "oxfmt --check src",
    "clean": "rimraf dist .tanstack node_modules bun.lock .turbo .wrangler",
    "build": "vite build",
    "preview": "REACT_COMPILER=true vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@durable-streams/client": "^0.2.7",
    "@durable-streams/server-cloudflare": "^0.1.1",
    "@durable-streams/state": "^0.3.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@monrep/db": "workspace:^",
    "@monrep/hooks": "workspace:^",
    "@monrep/ui": "workspace:^",
    "@monrep/utils": "workspace:^",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/charts": "^1.0.0",
    "@tanstack/react-db": "^0.5.3",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-store": "^0.11.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-scale": "^4.0.2",
    "otpauth": "^9.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "temporal-polyfill": "^1.0.5",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@monrep/codegen": "workspace:^",
    "@cloudflare/vite-plugin": "^1.62.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxc-transform-react": "^0.152.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-bundle-analyzer": "^1.3.9",
    "wrangler": "^4.147.0"
  }
