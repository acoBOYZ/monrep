    "@tanstack/router-cli": "^1.167.38",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxc-transform-react": "^0.151.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-bundle-analyzer": "^1.3.9",
    "wrangler": "^4.140.0"
  }
