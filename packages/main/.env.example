ADMIN_EMAIL=admin@monrep.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=dev-only-change-me-to-a-long-random-string
# Prefer distinct secrets in prod (Wrangler secrets). Dev may omit → falls back to SESSION_SECRET.
# AUTH_PENDING_SECRET=
# AUTH_CHALLENGE_SECRET=
#
# AUTH_ENC_KEY — AES key for encrypting stored TOTP secrets (auth.totp.secretEnc).
# NEVER rotate or change this value after any admin has enrolled TOTP.
# Changing it (or switching from SESSION_SECRET fallback → a new AUTH_ENC_KEY) makes
# existing ciphertext undecryptable: login TOTP verify fails with AES-GCM auth errors.
# Recovery then requires deleting the totp row and forcing re-enroll (users must re-scan QR).
# Set once in prod as a Wrangler secret; omit in early dev only if you accept SESSION_SECRET
# as the enc key and will not introduce AUTH_ENC_KEY later without wiping totp data.
# AUTH_ENC_KEY=
#
# Cookie names — use __Host- prefix on HTTPS prod (forces Secure + Path=/).
# AUTH_SESSION_COOKIE=__Host-monrep_session
# AUTH_PENDING_COOKIE=__Host-monrep_auth_pending
# AUTH_CHALLENGE_COOKIE=__Host-monrep_webauthn_challenge
# AUTH_COOKIE_SECURE=true
# Cloudflare Turnstile always-pass test keys (dev only) — replace in prod
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=https://localhost:5274
